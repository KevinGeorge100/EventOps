<%- include('partials/header', { title: title }) %>

  <!-- ─── Hero Section ──────────────────────────────────── -->
  <section class="hero">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>
    <div class="hero-content">
      <p class="hero-tag">✦ Curated Event Experiences</p>
      <h1 class="hero-title">
        Where <span class="gradient-text">Ideas</span> Take Flight
      </h1>
      <p class="hero-subtitle">
        Discover extraordinary events designed to inspire, connect, and elevate.
        Every moment crafted with precision.
      </p>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-number"><%= totalEvents %></span>
          <span class="stat-label">Events</span>
        </div>
        <div class="stat">
          <span class="stat-number"><%= upcomingEvents.length %></span>
          <span class="stat-label">Upcoming</span>
        </div>
        <div class="stat">
          <span class="stat-number">∞</span>
          <span class="stat-label">Possibilities</span>
        </div>
      </div>
      <a href="#events" class="cta-btn">
        Explore Events
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17L17 7M17 7H7M17 7V17"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- ─── Upcoming Events ────────────────────────────────── -->
  <section class="events-section" id="events">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Upcoming</span>
        <h2 class="section-title">Next on the Horizon</h2>
        <p class="section-subtitle">Don't miss these carefully crafted experiences</p>
      </div>

      <% if (upcomingEvents.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">📡</div>
          <h3>Stay Tuned</h3>
          <p>New events are being crafted. Check back soon for exciting announcements.</p>
        </div>
      <% } else { %>
        <div class="events-grid">
          <% upcomingEvents.forEach((event, index) => { %>
            <article class="event-card" style="animation-delay: <%= index * 0.1 %>s">
              <div class="event-card-accent"></div>
              <div class="event-card-content">
                <div class="event-date-badge">
                  <span class="event-month"><%= new Date(event.date).toLocaleDateString('en-US', { month: 'short' }) %></span>
                  <span class="event-day"><%= new Date(event.date).getDate() %></span>
                  <span class="event-year"><%= new Date(event.date).getFullYear() %></span>
                </div>
                <h3 class="event-title"><%= event.title %></h3>
                <p class="event-desc"><%= event.description %></p>
                <div class="event-footer">
                  <span class="event-status upcoming">
                    <span class="status-dot"></span>
                    Upcoming
                  </span>
                  <span class="event-countdown">
                    <% 
                      const diff = Math.ceil((new Date(event.date) - new Date()) / (1000 * 60 * 60 * 24));
                      if (diff === 0) { %>Today<% } 
                      else if (diff === 1) { %>Tomorrow<% } 
                      else { %><%= diff %> days away<% } %>
                  </span>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>

      <!-- ─── Past Events ──────────────────────────────────── -->
      <% if (pastEvents.length > 0) { %>
        <div class="section-header" style="margin-top: 5rem;">
          <span class="section-tag past-tag">Archive</span>
          <h2 class="section-title">Past Events</h2>
          <p class="section-subtitle">A look back at our previous experiences</p>
        </div>

        <div class="events-grid past-grid">
          <% pastEvents.forEach((event, index) => { %>
            <article class="event-card past-card" style="animation-delay: <%= index * 0.1 %>s">
              <div class="event-card-accent past-accent"></div>
              <div class="event-card-content">
                <div class="event-date-badge past-badge">
                  <span class="event-month"><%= new Date(event.date).toLocaleDateString('en-US', { month: 'short' }) %></span>
                  <span class="event-day"><%= new Date(event.date).getDate() %></span>
                  <span class="event-year"><%= new Date(event.date).getFullYear() %></span>
                </div>
                <h3 class="event-title"><%= event.title %></h3>
                <p class="event-desc"><%= event.description %></p>
                <div class="event-footer">
                  <span class="event-status past-status">
                    <span class="status-dot"></span>
                    Completed
                  </span>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <!-- ─── Footer ────────────────────────────────────────── -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-brand">
          <div class="logo">
            <span class="logo-icon">◆</span>
            <span class="logo-text">EventOps</span>
          </div>
          <p class="footer-tagline">Crafting extraordinary event experiences</p>
        </div>
        <div class="footer-links">
          <a href="/">Home</a>
          <a href="#events">Events</a>
          <a href="/admin">Dashboard</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> EventOps. All rights reserved.</p>
      </div>
    </div>
  </footer>

<%- include('partials/footer') %>
