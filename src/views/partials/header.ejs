<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description"
        content="EventOps — Curated event experiences. Discover, manage, and elevate your events with our modern platform." />
    <title>
        <%= typeof title !=='undefined' ? title : 'EventOps' %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="/css/styles.css" />
</head>

<body>

    <!-- ─── Top Navigation Bar ─────────────────────────────── -->
    <% if (typeof hideNav==='undefined' || !hideNav) { %>
        <nav class="site-nav" id="site-nav">
            <div class="nav-inner">
                <a href="/" class="logo">
                    <span class="logo-badge">Event</span><span class="logo-badge logo-badge-alt">Ops</span>
                </a>
                <div class="nav-links">
                    <a href="#events">Events</a>
                    <a href="#">About</a>
                    <a href="#">Pricing</a>
                </div>
                <div class="nav-actions">
                    <a href="/admin" class="nav-cta">Go to Dashboard <span class="nav-cta-arrow">→</span></a>
                </div>
            </div>
        </nav>
        <% } %>